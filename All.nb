   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "w1"}], "+", 
    RowBox[{"t", " ", "w2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The parametrization of line segment L is given by\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<L:z(t)=\>\"", ",", 
    RowBox[{"z", "[", "t", "]"}], ",", 
    "\"\<0\[LessEqual]t\[LessEqual]1\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
   RowBox[{"Exp", "[", "z", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<\!\(\*SubscriptBox[\(\[Integral]\), \
\(L\)]\)\!\(\*SuperscriptBox[\(e\), \(z\)]\)\[DifferentialD]z=\>\"", ",", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"z", "[", "t", "]"}], "]"}], 
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]}], "Input",
