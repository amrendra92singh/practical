   RowBox[{"z1", "\[Rule]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "w1", "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{"5", "+", "w1"}], ")"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
