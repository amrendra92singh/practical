Cell[CellGroupData[{

Cell["\<\
Practical 14
Locate the poles of  f[z] = 1/(5z^4 + 26 z^2 + 5) \
\>", "Subtitle",
 CellChangeTimes->{{3.986903037478589*^9, 3.986903040729792*^9}, {
  3.986903078174492*^9, 3.9869030822582693`*^9}, {3.986903897560209*^9, 
  3.986903898196241*^9}},ExpressionUUID->"5c993e74-9bb0-4736-a02b-\
71a5ba75aa38"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", 
   FractionBox["1", 
    RowBox[{
     RowBox[{"5", 
      SuperscriptBox["z", "4"]}], "+", 
     RowBox[{"26", 
      SuperscriptBox["z", "2"]}], "+", "5"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Denominator", "[", 
       RowBox[{"f", "[", "z", "]"}], "]"}], "\[Equal]", "0"}], ",", "z"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"z", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Poles are z1=\>\"", ",", 
   RowBox[{"a", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<,z2=\>\"", ",", 
   RowBox[{"a", "[", 
    RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<, z3=\>\"", ",", 
   RowBox[{"a", "[", 
    RowBox[{"[", "3", "]"}], "]"}], ",", "\"\< & z4 = \>\"", ",", 
   RowBox[{"a", "[", 
    RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.986903188008628*^9, 3.986903261864873*^9}, {
  3.9869033189759364`*^9, 3.9869035655461893`*^9}, {3.986903799444869*^9, 
  3.986903807051665*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"44dfbb88-eabc-4075-9a9a-ab75cd6c0eca"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Poles are z1=\"\>", "\[InvisibleSpace]", 
   RowBox[{"-", 
    FractionBox["\[ImaginaryI]", 
     SqrtBox["5"]]}], "\[InvisibleSpace]", "\<\",z2=\"\>", 
   "\[InvisibleSpace]", 
   FractionBox["\[ImaginaryI]", 
    SqrtBox["5"]], "\[InvisibleSpace]", "\<\", z3=\"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    SqrtBox["5"]}], "\[InvisibleSpace]", "\<\" & z4 = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"\[ImaginaryI]", " ", 
    SqrtBox["5"]}]}],
  SequenceForm[
  "Poles are z1=", Complex[0, -1] 5^Rational[-1, 2], ",z2=", Complex[0, 1] 
   5^Rational[-1, 2], ", z3=", Complex[0, -1] 5^Rational[1, 2], " & z4 = ", 
   Complex[0, 1] 5^Rational[1, 2]],
  Editable->False]], "Print",
 CellChangeTimes->{
  3.986903382678906*^9, 3.9869034992669487`*^9, {3.986903534665425*^9, 
   3.986903567899226*^9}, 3.986903808332597*^9},
 CellLabel->
  "During evaluation of \
In[145]:=",ExpressionUUID->"a18b4a64-683f-48d5-a471-acaa0d633138"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Practical 15\n",
 StyleBox[" Locate the poles and zeroes of g[z] = \[Pi]Cot[\[Pi]z]/z^2, \
Determine their order, also justify that Res(g,\[Theta])=- -(\[Pi]^2)/3",
  FontSize->16]
}], "Subtitle",
 CellChangeTimes->{{3.9869038498912525`*^9, 3.986903851587981*^9}, {
  3.986904064007614*^9, 
  3.986904083904237*^9}},ExpressionUUID->"77b8052a-71b1-408c-bf5e-\
670b9c26e806"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "z_", "]"}], ":=", 
   FractionBox[
    RowBox[{"Pi", "*", 
     RowBox[{"Cot", "[", 
      RowBox[{"Pi", "*", "z"}], "]"}]}], 
    SuperscriptBox["z", "2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pole", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Denominator", "[", 
       RowBox[{"g", "[", "z", "]"}], "]"}], "\[Equal]", "0"}], ",", "z"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zero", "=", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", "z", "]"}], "\[Equal]", "0"}], ",", "z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{"Residue", "[", 
    RowBox[{
     RowBox[{"g", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Poles are  \>\"", ",", "pole"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<zeroes are   \>\"", ",", "zero"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Residue of g[z] at z=0 is \>\"", ",", "res"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9869040967583385`*^9, 3.9869043836541257`*^9}, {
  3.98690461119073*^9, 3.9869046270256395`*^9}, {3.986904726409114*^9, 
  3.986904747434269*^9}, {3.986904853679621*^9, 3.9869048541095*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"10ef58f9-1272-4a6c-9587-062172a4870e"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Poles are  \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", "\[Rule]", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", "\[Rule]", "0"}], "}"}]}], "}"}]}],
  SequenceForm["Poles are  ", {{$CellContext`z -> 0}, {$CellContext`z -> 0}}],
  Editable->False]], "Print",
 CellChangeTimes->{3.986904279358678*^9, 3.9869043848763366`*^9, 
  3.986904627896446*^9, 3.986904748586718*^9, 3.9869048558312025`*^9},
 CellLabel->
  "During evaluation of \
In[177]:=",ExpressionUUID->"2fcad8ff-bf38-438e-a846-7e7304cb432c"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    RowBox[{"\<\"zeroes are   \"\>", "\[InvisibleSpace]", 
     TemplateBox[{"1"},
      "C"]}], "\[Element]", 
    TemplateBox[{},
     "Integers"]}], "&&", 
   RowBox[{"z", "\[NotEqual]", "0"}], "&&", 
   RowBox[{"z", "\[Equal]", 
    FractionBox[
     RowBox[{
      FractionBox["\[Pi]", "2"], "+", 
      RowBox[{"\[Pi]", " ", 
       TemplateBox[{"1"},
        "C"]}]}], "\[Pi]"]}]}],
  SequenceForm["zeroes are   ", 
   And[
    Element[
     C[1], Integers], $CellContext`z != 0, $CellContext`z == 
    Pi^(-1) (Rational[1, 2] Pi + Pi C[1])]],
  Editable->False]], "Print",
 CellChangeTimes->{3.986904279358678*^9, 3.9869043848763366`*^9, 
  3.986904627896446*^9, 3.986904748586718*^9, 3.9869048558312025`*^9},
 CellLabel->
  "During evaluation of \
In[177]:=",ExpressionUUID->"017edf57-7b2c-4977-808a-d355fee33da5"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Residue of g[z] at z=0 is \"\>", "\[InvisibleSpace]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["\[Pi]", "2"], "3"]}]}],
  SequenceForm["Residue of g[z] at z=0 is ", Rational[-1, 3] Pi^2],
  Editable->False]], "Print",
