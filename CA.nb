Cell[CellGroupData[{

Cell[TextData[{
 "Practical 4\n",
 StyleBox["Show that the image of the open disk D1 (\[Minus]1 \[Minus] \
\|01d456) = {\|01d467 : \|01d467 + 1 + \|01d456 < 1} under the linear \
transformation w = f (z) = (3\[Dash]4 i) z + (6 + 2 i) is the open disk : D5 \
(\[Dash]1 + 3 i) = {w : w + 1\[Dash]",
  FontSize->18],
 StyleBox["3 i < 5}.",
  FontSize->14]
}], "Subtitle",
 CellChangeTimes->{{3.986819600203755*^9, 3.986819631649933*^9}, {
  3.9868196708731804`*^9, 
  3.9868197778615656`*^9}},ExpressionUUID->"83c42f52-0eed-48c8-88d4-\
66a6e58dc6e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"w1", "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "-", 
        RowBox[{"4", "I"}]}], ")"}], "z1"}], "+", 
     RowBox[{"(", 
      RowBox[{"6", "+", 
       RowBox[{"2", "I"}]}], ")"}]}]}], ",", "z1"}], "]"}]], "Input",
 CellChangeTimes->{{3.9868198015260253`*^9, 3.9868198413137317`*^9}, {
  3.9868202460424204`*^9, 3.98682026584525*^9}, {3.9868203648816023`*^9, 
  3.986820370592607*^9}, {3.9868216796758127`*^9, 3.986821685821862*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"41ed4453-d7f4-4710-94f4-3ca81e54ac43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"z1", "\[Rule]", 
    RowBox[{
     FractionBox["1", "25"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "10"}], "+", 
       RowBox[{"3", " ", "w1"}], "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "15"}], "+", 
          RowBox[{"2", " ", "w1"}]}], ")"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9868198435159264`*^9, {3.986820254065242*^9, 3.9868202696726665`*^9}, 
