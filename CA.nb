Cell[TextData[{
 "Practical 10\n",
 StyleBox[" Plot the semicircle\[CloseCurlyQuote]C\[CloseCurlyQuote]with the \
radius 1 at z = 2and evaluate the contour integral  \[Integral]c  1/(z-2)dz",
  FontSize->18]
}], "Subtitle",
 CellChangeTimes->{{3.9868970327446213`*^9, 3.986897036738844*^9}, {
