   RowBox[{
    SubscriptBox["z", "1"], "\[Rule]", 
    RowBox[{
     FractionBox["1", "25"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "10"}], "+", 
       RowBox[{"3", " ", 
        SubscriptBox["w", "1"]}], "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "15"}], "+", 
          RowBox[{"2", " ", 
           SubscriptBox["w", "1"]}]}], ")"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
