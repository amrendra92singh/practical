Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"3", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "z"}], ")"}]}]], "-", 
  FractionBox["1", 
   RowBox[{"2", " ", 
    SuperscriptBox["z", "2"]}]], "-", 
  FractionBox["1", 
   RowBox[{"4", " ", "z"}]], "-", 
  FractionBox["1", 
   RowBox[{"12", " ", 
    RowBox[{"(", 
     RowBox[{"2", "+", "z"}], ")"}]}]]}]], "Output",
 CellChangeTimes->{{3.986905001157201*^9, 3.9869050101289983`*^9}},
 CellLabel->
  "Out[187]=",ExpressionUUID->"7d01fcb3-59e5-4ea6-b949-19e25e8bd18f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r1", "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"g", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r2", "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"g", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "1", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r3", "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"g", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "2"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\< The residue of g[z] at z = 0 is \>\"", ",", "r1", ",", 
    "\"\< , at z = 1 is \>\"", ",", "r2", ",", "\"\< & at z = -2 is \>\"", 
    ",", " ", "r3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"integral", "=", 
   RowBox[{"2", " ", "Pi", " ", "I", "*", 
    RowBox[{"(", 
     RowBox[{"r1", "+", "r2", "+", "r3"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<The value of\!\(\*SubscriptBox[\(\[Integral]\), \
\(c1\)]\)\!\(\*FractionBox[\(1\), \(\*SuperscriptBox[\(z\), \(4\)] + \
\*SuperscriptBox[\(z\), \(3\)] - 2 \*SuperscriptBox[\(z\), \(2\)]\)]\)\
\[DifferentialD]z by Cauchy residue theorem is \>\"", ",", "integral"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.986905018564332*^9, 3.9869053628988285`*^9}},
