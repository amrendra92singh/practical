     RowBox[{"ImageSize", "\[Rule]", "Small"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<z: Re[z]>1\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
