Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"C1: z1[t]=\"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[ImaginaryI]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}]}], "-", "t"}], 
   "\[InvisibleSpace]", "\<\"  0<=t<=1\"\>"}],
  SequenceForm[
  "C1: z1[t]=", Complex[-1, 1] (1 - $CellContext`t) - $CellContext`t, 
