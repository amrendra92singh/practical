Cell[CellGroupData[{

Cell[TextData[{
 "Practical 9\n",
 StyleBox[" Find the line segment \[OpenCurlyDoubleQuote]L\
\[CloseCurlyDoubleQuote] joining the point A=0 to B=2+I (Pi/4), and give the \
exact calculation of Contour Integral e^z dz",
  FontSize->16]
}], "Subtitle",
 CellChangeTimes->{{3.986896482609482*^9, 3.9868965019000225`*^9}, {
  3.986903996323782*^9, 
  3.9869039968362226`*^9}},ExpressionUUID->"3e4a2133-e8d4-4d0c-8a3e-\
c45c5741e224"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", ":=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", ":=", 
   RowBox[{"2", "+", 
    RowBox[{"I", "*", 
     RowBox[{"Pi", "/", "4"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "a"}], "+", 
    RowBox[{"t", "*", "b"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", 
   RowBox[{"Exp", "[", "z", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\< The parametrization of line seqment l joining points A to B is \>\"",
     ",", 
    RowBox[{"z", "[", "t", "]"}], ",", 
    "\"\<   0\[LessEqual]t\[LessEqual]1\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The plot of line segment L is given by figure\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Value of Integral is \>\"", ",", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"z", "[", "t", "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.986896615565639*^9, 3.9868970142420645`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"530f32c3-d731-471f-a4e7-c8dbf79e089b"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\" The parametrization of line seqment l joining points A to B \
is \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "+", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "\[Pi]"}], "4"]}], ")"}], " ", "t"}], 
   "\[InvisibleSpace]", "\<\"   0\[LessEqual]t\[LessEqual]1\"\>"}],
  SequenceForm[
  " The parametrization of line seqment l joining points A to B is ", (2 + 
    Complex[0, 
       Rational[1, 4]] Pi) $CellContext`t, "   0\[LessEqual]t\[LessEqual]1"],
  Editable->False]], "Print",
 CellChangeTimes->{3.986897015200816*^9},
 CellLabel->
  "During evaluation of \
In[18]:=",ExpressionUUID->"99559552-7c01-4559-891b-1f405b1b0dc8"],

Cell[BoxData["\<\"The plot of line segment L is given by figure\"\>"], "Print",
 CellChangeTimes->{3.986897015232584*^9},
 CellLabel->
  "During evaluation of \
In[18]:=",ExpressionUUID->"bc7697ee-2810-426f-9e1e-7d715ee0603e"]
}, Open  ]],

