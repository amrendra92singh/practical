Cell[CellGroupData[{

Cell[TextData[{
 "Practical 16\n",
 StyleBox[" Evaluate \[Integral]c1(\[Theta]) e^(2/z) dz , where c1(0)  \
denotes the circle {z : |z|=1} with positive orientation. Similarly evaluate ",
  FontSize->16],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Integral]", "c1"], 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["z", "4"], "+", 
      SuperscriptBox["z", "3"], "-", 
      RowBox[{"2", 
       SuperscriptBox["z", "2"]}]}]], 
    RowBox[{"\[DifferentialD]", "z"}]}]}]],
  CellChangeTimes->{{3.986905018564332*^9, 3.986905310821511*^9}},
