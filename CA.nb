Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"w1", "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ")"}], "z1"}], "-", "2", "+", 
     RowBox[{"3", "I"}]}]}], ",", "z1"}], "]"}]], "Input",
