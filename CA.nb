Cell[CellGroupData[{

Cell["\<\
Practical 6
Same as 4 & 5\
\>", "Subtitle",
 CellChangeTimes->{{3.986822454471543*^9, 
  3.986822470871481*^9}},ExpressionUUID->"b3e9cad7-7101-4675-9a93-\
f548050d5595"],

Cell[TextData[{
 "Practical 7\n",
 StyleBox["Make a plot of the vertical lines x=a for a = -1, -1/2, 1/2, 1 and \
horizontal lines y = b for b = -1, -1/2, 1/2, 1. Find plot of this grid under \
mapping w = f[z]= 1/z.",
  FontSize->16]
}], "Subtitle",
 CellChangeTimes->{{3.986822476026188*^9, 3.9868224797519135`*^9}, {
  3.986822944612256*^9, 
  3.986823075214535*^9}},ExpressionUUID->"274b1c96-8fc8-4f1f-9e9a-\
8fdddceb8883"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z", "=", 
   RowBox[{"x", "+", 
    RowBox[{"I", "*", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A1", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", "z", "]"}], "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{
        RowBox[{"Re", "[", "z", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Re", "[", "z", "]"}], "\[Equal]", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Re", "[", "z", "]"}], "\[Equal]", "1"}], ",", 
       RowBox[{
        RowBox[{"Im", "[", "z", "]"}], "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{
        RowBox[{"Im", "[", "z", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Im", "[", "z", "]"}], "\[Equal]", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Im", "[", "z", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"Axes", "\[Rule]", "True"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "250"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Re[z]\[Equal]-1\>\"", ",", "\"\<Re[z]\[Equal]-1/2\>\"", ",", 
        "\"\<Re[z]\[Equal]1/2\>\"", ",", "\"\<Re[z]\[Equal]1\>\"", ",", 
        "\"\<Im[z]\[Equal]-1\>\"", ",", "\"\<Im[z]\[Equal]-1/2\>\"", ",", 
        "\"\<Im[z]\[Equal]1/2\>\"", ",", "\"\<Im[z]\[Equal]1\>\""}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A2", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", "1"}], ",", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"1", "/", "z"}], "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"Axes", "\[Rule]", "True"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "250"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Re[1/z]\[Equal]-1\>\"", ",", "\"\<Re[1/z]\[Equal]-1/2\>\"", ",", 
        "\"\<Re[1/z]\[Equal]1/2\>\"", ",", "\"\<Re[1/z]\[Equal]1\>\"", ",", 
        "\"\<Im[1/z]\[Equal]-1\>\"", ",", "\"\<Im[1/z]\[Equal]-1/2\>\"", ",", 
        "\"\<Im[1/z]\[Equal]1/2\>\"", ",", "\"\<Im[1/z]\[Equal]1\>\""}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"A1", ",", "A2"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9868231124318194`*^9, 3.986823490082178*^9}, {
  3.9868235364377813`*^9, 3.986823613771242*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"5b9aa182-b666-4b8f-971e-12593f344c78"],

