Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    SubscriptBox["w", "1"], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "-", 
        RowBox[{"4", " ", "I"}]}], ")"}], 
      SubscriptBox["z", "1"]}], "+", 
     RowBox[{"(", 
      RowBox[{"6", "+", 
       RowBox[{"2", " ", "I"}]}], ")"}]}]}], ",", 
