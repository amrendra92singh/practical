Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "z_", "]"}], ":=", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["z", "4"], "+", 
     SuperscriptBox["z", "3"], "-", 
     RowBox[{"2", 
      SuperscriptBox["z", "2"]}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Apart", "[", 
  RowBox[{"g", "[", "z", "]"}], "]"}]}], "Input",
