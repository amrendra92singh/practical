Cell[CellGroupData[{

Cell["Or", "Subtitle",
 CellChangeTimes->{{3.9869023672918596`*^9, 3.9869023706227036`*^9}, {
  3.9869025430121527`*^9, 
  3.9869025437965097`*^9}},ExpressionUUID->"d8ad4c5b-5610-4460-bd7b-\
6ac046cf1f88"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"z1", "=", 
   RowBox[{"2", "+", "I"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], "=", 
   RowBox[{"z0", "+", 
    RowBox[{"t", "*", 
     RowBox[{"(", 
      RowBox[{"z1", "-", "z0"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<The parametrization equation of the given curve is C : z[t] = \>\"", 
   ",", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
   "\"\< Where 0<t\[LessSlantEqual]1, which represent straight line joining \
the points z0 = \>\"", ",", "z0", ",", "\"\< and z1 = \>\"", ",", "z1", ",", 
   "\"\<.\>\""}], "]"}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"AxesStyle", "\[Rule]", 
      RowBox[{"Arrowheads", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.03"}], ",", "0.03"}], "}"}], "]"}]}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Green"}], "}"}]}], ",", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"Ticks", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "3", ",", ".5"}], "]"}], ",", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "2.5", ",", "0.5"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5"}], ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Show", "[", "p1", "]"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"z", "'"}], "[", "t", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "^", "2"}], "+", "1"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"i", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Im", "[", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"Maximize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "+", 
          RowBox[{"i", "^", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], ",", 
       RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "1"}]}], "}"}], ",", 
     "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ML", "=", 
   RowBox[{
    RowBox[{"M", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "*", "L"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<Length of the Arc is, L = \>\"", ",", "1", ",", 
   "\"\< and the value of M is \>\"", ",", 
   RowBox[{"M", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<.\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<Using the ML Inequality, we have an upper bound for the given integral \
as\>\"", ",", "ML", ",", "\"\<.\>\""}], "]"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
         RowBox[{"Im", "[", 
          RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "2"}]}], "]"}], ",", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
             RowBox[{"Im", "[", 
              RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
             RowBox[{"Im", "[", 
              RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}]}], "}"}]}], "}"}], 
       ",", 
       RowBox[{"AxesOrigin", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}]}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9869025303059807`*^9, 3.9869025303059807`*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"4cd70f96-1155-415c-85fa-5b36366e2ac4"],

