  RowBox[{"\<\"C2: z2[t]=\"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "+", "\[ImaginaryI]"}], ")"}], " ", "t"}]}], 
   "\[InvisibleSpace]", "\<\"  0<=t<=1\"\>"}],
  SequenceForm["C2: z2[t]=", -1 + Complex[2, 1] $CellContext`t, "  0<=t<=1"],
