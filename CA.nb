Cell[CellGroupData[{

Cell[TextData[{
 "Practical 11\n",
 StyleBox["Show that \[Integral]c1 zdz = \[Integral]c2 zdz = 4 + 2*I, where \
C1 is the line segment from-1+I to 3+I, andC2 is the portion of parabola x = \
y^2 +2y joining -I to 3+I.Make plots of two contours C1 and C2 joining -1-I \
to 3+I.",
  FontSize->16]
}], "Subtitle",
 CellChangeTimes->{{3.986897725412484*^9, 3.98689773036234*^9}, {
  3.986903934963024*^9, 
  3.9869039354801526`*^9}},ExpressionUUID->"7b5aa000-8a14-4b9c-9357-\
d9d214d49585"],

Cell[BoxData[" "], "Input",
 CellChangeTimes->{
  3.986897953675164*^9},ExpressionUUID->"2ef64797-3645-4a19-8e9d-\
bcf0bf00052d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"w1", ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "-", "I"}]}], ";", 
  RowBox[{"w2", ":=", 
   RowBox[{"3", "+", "I"}]}], ";", 
  RowBox[{
   RowBox[{"z1", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "*", "w1"}], "+", 
    RowBox[{"t", "*", "w2"}]}]}], ";", 
  RowBox[{
   RowBox[{"z2", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"t", "^", "2"}], "+", 
      RowBox[{"2", "t"}]}], ")"}], "+", 
    RowBox[{"I", "*", "t"}]}]}], ";", 
  RowBox[{
  "Print", "[", 
   "\"\<The parametrization of the line segment C1 is given by\>\"", 
   "]"}]}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<C1: z[t] = \>\"", ",", 
   RowBox[{"z1", "[", "t", "]"}], ",", "\"\< , 0<=t<=1\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  "\"\<The parametrization of the portion of parabola C2 is given by\>\"", 
  "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<C2: z[t] = \>\"", ",", 
   RowBox[{"z2", "[", "t", "]"}], ",", "\"\< ,-1<=t<=1\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  "\"\<The plots of the line segment C1 and portion of the parabola C2 is \
given by the figure\>\"", "]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"z1", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"z1", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"z2", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"z2", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}]}], "]"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", "z"}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<\[Integral]c1 zdz = \>\"", ",", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"z1", "[", "t", "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"z1", "'"}], "[", "t", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
   "\"\<------(1)\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<\[Integral]c2 zdz = \>\"", ",", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"z2", "[", "t", "]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"z2", "'"}], "[", "t", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
   "\"\<------(2)\>\""}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  "\"\<There by (1) and (2), we proved the required part.\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9869010072240086`*^9, 3.9869010072260203`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"d8071240-738b-4c5d-85fa-a6cb9d605626"],

Cell[CellGroupData[{

Cell[BoxData["\<\"The parametrization of the line segment C1 is given \
by\"\>"], "Print",
 CellChangeTimes->{3.986901009972548*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"03d3e4ff-09f7-41ce-abde-d598b48fa5ee"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"C1: z[t] = \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "-", "\[ImaginaryI]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "+", "\[ImaginaryI]"}], ")"}], " ", "t"}]}], 
   "\[InvisibleSpace]", "\<\" , 0<=t<=1\"\>"}],
  SequenceForm[
  "C1: z[t] = ", Complex[-1, -1] (1 - $CellContext`t) + 
   Complex[3, 1] $CellContext`t, " , 0<=t<=1"],
  Editable->False]], "Print",
