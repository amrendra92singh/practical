Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{3.9869014885619392`*^9, 3.9869014907350054`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"9ae594e9-6d3e-4f3e-8a87-6d48d0064127"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", ":=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", ":=", 
   RowBox[{"1", "+", "I"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "a"}], "+", 
    RowBox[{"t", "*", "b"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", 
   SuperscriptBox["z", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The parametrization of the line segment C : \>\"", ",", 
    RowBox[{"z", "[", "t", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Plot of Line segment C\>\""}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"z", "'"}], "[", "t", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Im", "[", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"Maximize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          SuperscriptBox["i", "2"]}], ")"}], 
        FractionBox["1", "2"]], ",", 
       RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "1"}]}], "}"}], ",", 
     "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ML", "=", 
   RowBox[{
    RowBox[{"M", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "*", "L"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<Thus by the ML inequality, upper bound of given integral is \>\"", ",",
    "ML", ",", "\"\<<=2\!\(\*SqrtBox[\(2\)]\)\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Hence the required inequality obtained\>\"", 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9869010566034393`*^9, 3.986901083891223*^9}, {
  3.9869011157101088`*^9, 3.986901160073772*^9}, {3.9869012651777363`*^9, 
  3.9869013669552903`*^9}, {3.9869014053992424`*^9, 3.9869014226489754`*^9}, {
  3.9869015011216183`*^9, 3.98690164460436*^9}, {3.986901705220269*^9, 
  3.986901709981903*^9}, {3.986901744552186*^9, 3.986901884821167*^9}, {
  3.9869019285652113`*^9, 3.986902162365731*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"959dd467-9205-4d85-9f30-2e217062867a"],

