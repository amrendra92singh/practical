Cell[CellGroupData[{

Cell[TextData[{
 "Practical 8\n",
 StyleBox["Find a parametric Representation of the path C = C1 + C2 + C3, \
FROM - 1 + I to 3 - I, where C1 is the line from - 1 + I to - 1; C2 is a line \
from - 1 to 1 + I and C 3 is a line from 1 + I to 3 - I. Make a plot of this \
path.",
  FontSize->14]
}], "Subtitle",
 CellChangeTimes->{{3.9868244801555133`*^9, 3.9868244876427813`*^9}, {
  3.9868245403317657`*^9, 3.9868245417867184`*^9}, {3.9868249779433236`*^9, 
  3.9868249833235526`*^9}},ExpressionUUID->"8003152f-39d6-4fca-ba13-\
36f9f4db1dfc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"w1", ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "I"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w2", ":=", 
   RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w3", ":=", 
   RowBox[{"1", "+", "I"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w4", ":=", 
   RowBox[{"3", "-", "I"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z1", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "w1"}], "+", 
    RowBox[{"t", " ", "w2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z2", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "w2"}], "+", 
    RowBox[{"t", " ", "w3"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z3", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "t"}], ")"}], "w3"}], "+", 
    RowBox[{"t", " ", "w4"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<The Parametric representation of path C1,C2,C3 is given by\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<C1: z1[t]=\>\"", ",", 
   RowBox[{"z1", "[", "t", "]"}], ",", "\"\<  0<=t<=1\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<C2: z2[t]=\>\"", ",", 
   RowBox[{"z2", "[", "t", "]"}], ",", "\"\<  0<=t<=1\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<C3: z3[t]=\>\"", ",", 
   RowBox[{"z3", "[", "t", "]"}], ",", "\"\<  0<=t<=1\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<The plot of the polynomial C= C1+C2+C3 is given by figure \>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"z1", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"z1", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"z2", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"z2", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"z3", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"z3", "[", "t", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Green", ",", "Red", ",", "Yellow"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.986824587789717*^9, 3.986824852535454*^9}, {
  3.9868249177157707`*^9, 3.986825126754163*^9}, {3.9868252512246227`*^9, 
  3.986825501444677*^9}, {3.9868255394948435`*^9, 3.9868256040222387`*^9}, {
  3.9868256469265614`*^9, 3.98682566674507*^9}, {3.986896432084097*^9, 
  3.986896433067236*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3b629ea1-9d1d-48dd-8911-b19d7e972bf0"],

